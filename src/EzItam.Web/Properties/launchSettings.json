        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "sqlite-demo": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5006",
