@model EzItam.Web.Services.Erp.ErpSyncResult
@{ ViewData["Title"] = "ERP 연동"; bool available = ViewBag.IsAvailable; }
<partial name="_PageHeader" model="@("Oracle EBS 연동")" />
<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100"><div class="card-header">조직 / 사원 동기화</div><div class="card-body">
            <p class="small text-muted">Oracle EBS 11i 의 HR 조직(HR_ALL_ORGANIZATION_UNITS)과 사원(PER_ALL_PEOPLE_F / PER_ALL_ASSIGNMENTS_F) 정보를 읽어 ITAM 부서·사원 마스터에 반영합니다. 사번/조직 ID 기준으로 업서트하며, ERP에서 사라진 사원은 퇴직 처리됩니다.</p>
            @if (available)
            {
                <form asp-action="Sync" method="post" data-once onsubmit="return confirm('ERP 동기화를 실행하시겠습니까?');">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-primary">지금 동기화</button>
                </form>
            }
            else
            {
                <div class="alert alert-warning mb-0">
                    ERP 연동이 비활성화되어 있습니다. <code>appsettings.json</code> 의 <code>OracleEbs:Enabled</code> 를 <code>true</code> 로 설정하고 <code>OracleEbs:ConnectionString</code> 을 지정하세요.
                    <pre class="mb-0 mt-2 small">"OracleEbs": {
  "Enabled": true,
  "ConnectionString": "User Id=apps;Password=***;Data Source=//ebs-db:1521/PROD"
}</pre>
                </div>
            }
        </div></div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100"><div class="card-header">최근 실행 결과</div><div class="card-body">
            @if (Model is null) { <div class="text-muted">아직 실행된 적이 없습니다. (서버 재시작 후 초기화)</div> }
            else
            {
                <dl class="dl-grid">
                    <dt>결과</dt><dd>@if (Model.Succeeded) { <span class="badge bg-success">성공</span> } else { <span class="badge bg-danger">실패</span> <span class="text-danger small">@Model.Error</span> }</dd>
                    <dt>시작</dt><dd>@Model.StartedAt.Ymdhm()</dd>
                    <dt>종료</dt><dd>@Model.FinishedAt.Ymdhm()</dd>
                    <dt>부서</dt><dd>신규 @Model.DepartmentsInserted · 변경 @Model.DepartmentsUpdated</dd>
                    <dt>사원</dt><dd>신규 @Model.EmployeesInserted · 변경 @Model.EmployeesUpdated · 퇴직 @Model.EmployeesDeactivated</dd>
                </dl>
            }
        </div></div>
    </div>
</div>
