@{
    ViewData["Title"] = L["오류"];
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_Layout";
    int? code = ViewBag.Code as int?;
}
<div class="text-center py-5">
    <h1 class="display-4">@(code?.ToString() ?? L["오류"])</h1>
    <p class="lead">
        @(code switch
        {
            404 => L["요청하신 페이지를 찾을 수 없습니다."],
            403 => L["접근 권한이 없습니다."],
            _ => L["요청을 처리하는 중 오류가 발생했습니다."]
        })
    </p>
    <p class="text-muted small">Request ID: <code>@ViewBag.RequestId</code></p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">@L["대시보드로 이동"]</a>
</div>
