@model AgentDto
@{
    ViewData["Title"] = Model.HostName;
    var canEdit = User.IsInRole("Admin") || User.IsInRole("Manager");
    var software = ViewBag.Software as List<AgentSoftwareDto> ?? new();
}
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <a class="small text-muted" asp-action="Index">@L["← 에이전트 목록"]</a>
        <h1 class="h4 mb-0">@Model.HostName <span class="badge bg-secondary">@Model.Status.Display()</span> @if (Model.IsOnline) { <span class="badge bg-success">@L["온라인"]</span> }</h1>
    </div>
    @if (canEdit)
    {
        <div class="d-flex gap-2">
            @if (Model.Status != AgentStatus.Approved)
            {
                <form asp-action="Approve" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button class="btn btn-sm btn-success">@L["승인"]</button></form>
            }
            @if (Model.Status != AgentStatus.Disabled)
            {
                <form asp-action="Disable" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('@L["사용 중지하면 에이전트 토큰이 폐기됩니다. 계속할까요?"]');">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger">@L["사용 중지"]</button></form>
            }
        </div>
    }
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card h-100"><div class="card-header">@L["장치 정보"]</div><div class="card-body">
            <dl class="dl-grid">
                <dt>@L["장치 UUID"]</dt><dd class="text-break"><code>@Model.DeviceUuid</code></dd>
                <dt>@L["시리얼"]</dt><dd>@(Model.SerialNumber ?? "-")</dd>
                <dt>@L["제조사 / 모델"]</dt><dd>@Model.Manufacturer @Model.Model</dd>
                <dt>CPU</dt><dd>@(Model.CpuName ?? "-") @(Model.CpuCores.HasValue ? L["({0}코어)", Model.CpuCores] : "")</dd>
                <dt>@L["메모리"]</dt><dd>@(Model.TotalMemoryMb.HasValue ? $"{Model.TotalMemoryMb:#,##0} MB" : "-")</dd>
                <dt>@L["디스크"]</dt><dd>@(Model.DiskTotalGb.HasValue ? $"{Model.DiskTotalGb} GB" : "-")</dd>
                <dt>OS</dt><dd>@Model.OsName @Model.OsVersion @Model.OsBuild</dd>
                <dt>BitLocker</dt><dd>@(Model.BitLockerOn switch { true => L["사용"], false => L["미사용"], _ => "-" })</dd>
                <dt>@L["사용자"]</dt><dd>@(Model.LoggedOnUser ?? "-")</dd>
                <dt>IP / MAC</dt><dd>@(Model.IpAddress ?? "-") / @(Model.MacAddresses ?? "-")</dd>
                <dt>@L["재부팅 대기"]</dt><dd>@(Model.RebootPending ? L["예"] : L["아니오"])</dd>
                <dt>@L["에이전트 버전"]</dt><dd>@Model.AgentVersion</dd>
                <dt>@L["등록 / 마지막 접속"]</dt><dd>@Model.EnrolledAt.Ymdhm() / @Model.LastSeenAt.Ymdhm()</dd>
            </dl>
        </div></div>
    </div>
    <div class="col-lg-7">
        <div class="card mb-3"><div class="card-header">@L["자산 연결"]</div><div class="card-body">
            @if (Model.Asset is not null)
            {
                <p>@L["연결된 자산:"] <a asp-controller="Assets" asp-action="Details" asp-route-id="@Model.AssetId"><strong>@Model.Asset.AssetTag</strong> @Model.Asset.Name</a></p>
            }
            else
            {
                <p class="text-muted">@L["연결된 자산이 없습니다. 시리얼 또는 호스트명이 같은 자산을 자동으로 찾아 연결하며, 아래에서 직접 지정할 수도 있습니다."]</p>
            }
            @if (canEdit)
            {
                <form asp-action="Link" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="col-md-8"><select name="assetId" class="form-select form-select-sm" asp-items="ViewBag.Assets"><option value="">@L["-- 연결 해제 --"]</option></select></div>
                    <div class="col-md-4"><button class="btn btn-sm btn-primary">@L["연결 저장"]</button></div>
                </form>
            }
        </div></div>
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>@L["설치 소프트웨어 ({0})", ViewBag.SoftwareCount]</span>
                <form method="get" class="d-flex gap-1">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input name="q" value="@ViewBag.Query" class="form-control form-control-sm" placeholder="@L["소프트웨어 검색"]" />
                    <button class="btn btn-sm btn-outline-secondary">@L["검색"]</button>
                </form>
            </div>
            <div class="table-responsive" style="max-height:560px;overflow:auto">
            <table class="table table-sm mb-0">
                <thead class="table-light sticky-top"><tr><th>@L["이름"]</th><th>@L["게시자"]</th><th>@L["버전"]</th><th>@L["설치일"]</th><th>@L["출처"]</th></tr></thead>
                <tbody>
                @foreach (var s in software)
                {
                    <tr><td>@s.Name</td><td class="small">@s.Publisher</td><td class="small">@s.Version</td><td class="small">@s.InstallDate</td><td class="small text-muted">@s.Source</td></tr>
                }
                @if (software.Count == 0) { <tr><td colspan="5" class="text-muted">@L["소프트웨어 정보가 없습니다."]</td></tr> }
                </tbody>
            </table></div>
        </div>
    </div>
</div>
