@model LoginViewModel
@{ ViewData["Title"] = L["login.title"]; }
<div class="card login-card">
    <div class="card-body p-4">
        <div class="text-center mb-4">
            <div class="h3 mb-0"><span class="badge bg-primary">EZ</span> ITAM</div>
            <div class="text-muted small">@L["login.subtitle"]</div>
        </div>
        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <div class="mb-3">
                <label asp-for="UserName" class="form-label">@L["login.username"]</label>
                <input asp-for="UserName" class="form-control" autofocus autocomplete="username" />
                <span asp-validation-for="UserName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">@L["login.password"]</label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">@L["login.remember"]</label>
            </div>
            <button type="submit" class="btn btn-primary w-100">@L["login.submit"]</button>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
