@model CheckInViewModel
@{ ViewData["Title"] = L["반납"]; }
<partial name="_PageHeader" model="@(L["반납 - {0} {1}", Model.AssetTag, Model.AssetName].Value)" />
<div class="card" style="max-width:560px"><div class="card-body">
    <p>@L["현재 사용자:"] <strong>@Model.CurrentEmployeeName</strong></p>
    <form asp-action="CheckIn" method="post" data-once>
        <input type="hidden" asp-for="AssetId" /><input type="hidden" asp-for="AssetTag" /><input type="hidden" asp-for="AssetName" /><input type="hidden" asp-for="CurrentEmployeeName" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <div class="mb-3">
            <label asp-for="NewStatus" class="form-label"></label>
            <select asp-for="NewStatus" class="form-select" asp-items="ViewBag.Statuses"></select>
        </div>
        <div class="mb-3">
            <label asp-for="LocationId" class="form-label"></label>
            <select asp-for="LocationId" class="form-select" asp-items="ViewBag.Locations"><option value="">@L["-- 변경 없음 --"]</option></select>
        </div>
        <div class="mb-3">
            <label asp-for="Notes" class="form-label"></label>
            <input asp-for="Notes" class="form-control" placeholder="@L["예: 퇴사 반납, 상태 양호"]" />
        </div>
        <button type="submit" class="btn btn-warning">@L["반납 처리"]</button>
        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.AssetId">@L["취소"]</a>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
