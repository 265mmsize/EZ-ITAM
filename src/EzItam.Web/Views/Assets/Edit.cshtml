@model Asset
@{ ViewData["Title"] = "자산 수정"; }
<partial name="_PageHeader" model="@($"자산 수정 - {Model.AssetTag}")" />
<div class="alert alert-light border py-2 small">사용자/상태는 상세 화면의 <strong>불출 · 반납 · 상태변경</strong> 기능으로 변경하세요. (이력이 기록됩니다)</div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" data-once>
    <partial name="_Form" model="Model" />
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">저장</button>
        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">취소</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
