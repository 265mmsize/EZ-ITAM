@model AssetDto
@{ ViewData["Title"] = L["자산 등록"]; }
<partial name="_PageHeader" model="@(L["자산 등록"].Value)" />
<form asp-action="Create" method="post" data-once>
    <partial name="_Form" model="Model" />
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">@L["등록"]</button>
        <a class="btn btn-outline-secondary" asp-action="Index">@L["취소"]</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
