@model List<SoftwareLicenseDto>
@{ ViewData["Title"] = "소프트웨어 라이선스"; bool expiringOnly = ViewBag.ExpiringOnly; var canEdit = User.IsInRole("Admin") || User.IsInRole("Manager"); }
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="h4 mb-0">소프트웨어 라이선스 <span class="text-muted fs-6">@(Model.Count)건</span></h1>
    @if (canEdit) { <a class="btn btn-primary btn-sm" asp-action="Create">+ 라이선스 등록</a> }
</div>
<div class="card mb-3"><div class="card-body py-2">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small mb-0">검색</label>
            <input name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="소프트웨어명, 제조사" />
        </div>
        <div class="col-md-3">
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="expiringOnly" name="expiringOnly" value="true" @(expiringOnly ? "checked" : "") />
                <label class="form-check-label" for="expiringOnly">만료(임박 포함)만</label>
            </div>
        </div>
        <div class="col-md-2 d-flex gap-1"><button class="btn btn-sm btn-primary">검색</button><a class="btn btn-sm btn-outline-secondary" asp-action="Index">초기화</a></div>
    </form>
</div></div>
<div class="card"><div class="table-responsive">
    <table class="table table-sm table-hover mb-0">
        <thead class="table-light"><tr><th>소프트웨어</th><th>제조사</th><th>유형</th><th>사용 / 보유</th><th style="width:140px">사용률</th><th>만료일</th><th>공급업체</th><th>비용</th></tr></thead>
        <tbody>
        @foreach (var l in Model)
        {
            var unlimited = l.LicenseType is LicenseType.Site or LicenseType.Free;
            var pct = unlimited || l.TotalSeats == 0 ? 0 : Math.Min(100, 100 * l.UsedSeats / l.TotalSeats);
            var over = !unlimited && l.UsedSeats > l.TotalSeats;
            <tr>
                <td><a asp-action="Details" asp-route-id="@l.Id"><strong>@l.Name</strong></a> <span class="text-muted small">@l.Version</span></td>
                <td>@l.Publisher</td>
                <td>@l.LicenseType.Display()</td>
                <td class="@(over ? "text-danger fw-bold" : "")">@l.UsedSeats / @(unlimited ? "무제한" : l.TotalSeats.ToString())</td>
                <td>@if (!unlimited) { <div class="bar"><span style="width:@pct%;background:@(over ? "#dc2626" : pct >= 90 ? "#f59e0b" : "#2563eb")"></span></div> }</td>
                <td class="@(l.IsExpired ? "text-danger" : l.IsExpiringSoon ? "text-warning fw-bold" : "")">@l.ExpiryDate.Ymd()</td>
                <td>@(l.Vendor?.Name ?? "-")</td>
                <td>@l.Cost.Money()</td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="8" class="text-center text-muted py-4">등록된 라이선스가 없습니다.</td></tr> }
        </tbody>
    </table>
</div></div>
