@model SoftwareLicenseDto
@{ ViewData["Title"] = L["라이선스 등록"]; }
<partial name="_PageHeader" model="@(L["라이선스 등록"].Value)" />
<div class="card" style="max-width:800px"><div class="card-body">
    <form asp-action="Create" method="post" data-once>
        <partial name="_Form" model="Model" />
        <button type="submit" class="btn btn-primary">@L["등록"]</button>
        <a class="btn btn-outline-secondary" asp-action="Index">@L["취소"]</a>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
