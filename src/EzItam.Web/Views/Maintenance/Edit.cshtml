@model MaintenanceRecord
@{ ViewData["Title"] = "유지보수 수정"; Asset asset = ViewBag.Asset; var isAdmin = User.IsInRole("Admin"); }
<partial name="_PageHeader" model="@($"유지보수 수정 - {asset.AssetTag} {asset.Name}")" />
<div class="card" style="max-width:640px"><div class="card-body">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" data-once>
        <partial name="_Form" model="Model" />
        @if (asset.Status == AssetStatus.InRepair)
        {
            <div class="form-check mb-3">
                <input type="checkbox" class="form-check-input" id="restoreToStock" name="restoreToStock" value="true" checked />
                <label class="form-check-label" for="restoreToStock">완료 처리 시 자산 상태를 '재고'로 복원</label>
            </div>
        }
        <button type="submit" class="btn btn-primary">저장</button>
        <a class="btn btn-outline-secondary" asp-controller="Assets" asp-action="Details" asp-route-id="@asset.Id">취소</a>
    </form>
    @if (isAdmin)
    {
        <hr />
        <partial name="_ConfirmDelete" model="@(("Maintenance", (object)Model.Id, "유지보수 이력"))" />
    }
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
