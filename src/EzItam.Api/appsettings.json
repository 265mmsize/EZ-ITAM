{
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=EzItam;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Database": {
    "Provider": "SqlServer",
    "AutoMigrate": true
  },
  "Seed": {
    "AdminUser": "admin",
    "AdminPassword": "Admin!2345",
    "AdminEmail": "admin@localhost",
    "SampleData": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ezitam-api",
    "Audience": "ezitam-clients",
    "Key": "CHANGE-ME-to-a-long-random-secret-at-least-32-chars",
    "ExpiresMinutes": 480
  },
  "Agent": {
    "EnrollmentKey": "change-me-enrollment-key"
  }
}